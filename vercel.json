{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "laouni-electricite.vercel.app" }],
      "destination": "https://www.laouni-electricitemoderne.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).(png|ico|svg|jpg|jpeg|webp)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
